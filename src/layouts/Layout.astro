---
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
---


<!doctype html>
<html lang="en">
	<head transition:animate="none">
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<ClientRouter/>
		<title>Data Management: Interactions with Computer Architecture and Systems</title>
	</head>
	<body class="bg-slate-950">
		<Header class="animate-slideFromTop sticky top-0 h-52"/>
		<main transition:animate="slide" class="mt-10">
			<slot />
		</main>
	</body>
</html>

<style is:global>
	@font-face {
  		font-family: 'Insignia LT Std';
  		src: url('/insignia-lt-std-roman-24032.ttf') format('truetype');
  		font-weight: normal;
  		font-style: normal;
  		font-display: swap;
	}

	* {
		font-family: 'Insignia LT Std', sans-serif;
	}
</style>
