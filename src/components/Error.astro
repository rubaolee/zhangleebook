---
const { page, line, original, change, reporter, date } = Astro.props;
---

<div class="rounded-2xl border border-slate-800 bg-slate-950/70 p-5">
    <p class="text-sm uppercase tracking-[0.18em] text-sky-300">Page {page}, line {line}</p>
    <p class="mt-2 text-slate-300">Reported by {reporter} on {date}</p>
    <p class="mt-3 text-slate-100">
        Change <span class="underline decoration-1">{original}</span> to <span class="underline decoration-1">{change}</span>.
    </p>
</div>
