---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';

import cover from '../../public/zhangleebook.png';
---

<Layout>
	<div class="flex flex-row justify-center md:inline">
		<Image class="lg:float-left flex w-72 lg:w-[30em] lg:ml-52" src={cover} alt="Front cover of the book Data Management Interactions with Computer Architecture and Systems"/>
	</div>
	<section class="flex flex-row justify-center lg:mr-52 text-sky-200 mx-7 lg:mx-0">
		<div class="mt-7 lg:ml-16">
			<h1 class="text-4xl lg:text-6xl text-amber-400">Data Management</h1>
			<h2 class="text-3xl lg:text-4xl text-slate-200 lg:ml-[2em]">Interactions with Computer Architecture and Systems</h2>
			<h2 class="text-2xl lg:text-3xl text-slate-200 mt-10">Authors</h2>
			<h3 class="text-xl text-amber-400">Xiaodong Zhang</h3>
			<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Donec in eleifend mi. Nullam sit amet urna sit amet tellus varius placerat.</p>
			<h3 class="text-xl text-amber-400">Rubao Lee</h3>
			<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Donec in eleifend mi. Nullam sit amet urna sit amet tellus varius placerat.</p>

			<h2 class="text-2xl lg:text-3xl text-slate-200 mt-5">Description</h2>
