---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<section class="mx-6 grid justify-center text-slate-200">
		<div class="justify-self-center rounded-3xl border border-slate-800 bg-slate-900/70 px-8 py-10 text-center shadow-xl">
			<h1 class="text-5xl text-amber-300">Contact</h1>
			<p class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-slate-300">
				Have a question about the book or an error to report? Please send email to
				<a class="font-semibold text-sky-300 hover:underline" href="mailto:lee.rubao@ieee.org">lee.rubao@ieee.org</a>.
			</p>
		</div>
	</section>
</Layout>
