---
import Layout from '../layouts/Layout.astro';
import Error from '../components/Error.astro';
import { Image } from 'astro:assets';

import cover from '../../public/zhangleebook.png';
---

<Layout>
	<div class="lg:flex lg:flex-row lg:justify-center lg:space-x-32">
		<div class="flex flex-row justify-center lg:mr-16">
			<Image class="lg:float-left flex w-72 lg:w-[30em] lg:ml-52" src={cover} alt="Front cover of the book Data Management Interactions with Computer Architecture and Systems"/>
		</div>
		<section class="lg:mr-52 text-sky-200 mx-7 lg:mx-0">
			<div class="mt-7">
				<h1 class="text-4xl text-center lg:text-left lg:text-6xl text-amber-400">Errata</h1>
				<p class="text-xl text-center lg:text-left mb-5">Please submit errors to <a class="hover:underline text-sky-100" href="mailto:">lee.lestat@gmail.com</a></p>
				<ul class="list-disc list-outside marker:text-4xl marker:ml-[-5em] ml-10 mr-5">
					<li>
						<Error
							page="0"
							line="0"
							original="Lorem ipsum dolor sit amet, consectetur adipiscing elit."
							change="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Lorem ipsum dolor sit amet, consectetur adipiscing elit.Lorem ipsum dolor sit amet, consectetur adipiscing elit."
							reporter="John Reporter"
							date="00/00/0000"
						/>
					</li>
					<li>
						<Error
							page="0"
							line="0"
							original="Lorem ipsum dolor sit amet, consectetur adipiscing elit."
							change="Lorem ipsum dolor sit amet, consectetur adipiscing elit."
							reporter="John Reporter"
							date="00/00/0000"
						/>
					</li>
					<li>
						<Error
							page="0"
							line="0"
							original="Lorem ipsum dolor sit amet, consectetur adipiscing elit."
							change="Lorem ipsum dolor sit amet, consectetur adipiscing elit."
							reporter="John Reporter"
							date="00/00/0000"
						/>
					</li>
				</ul>
				
			</div>
		</section>
	</div>
	
</Layout>
