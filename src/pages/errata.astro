---
import Layout from '../layouts/Layout.astro';
import Error from '../components/Error.astro';
import { Image } from 'astro:assets';

import cover from '../../public/zhangleebook.png';
---

<Layout>
	<div class="mx-6 grid gap-12 lg:mx-10 lg:grid-cols-[minmax(280px,420px)_minmax(0,720px)] lg:items-start lg:justify-center">
		<div class="flex justify-center">
			<Image class="w-72 rounded-2xl border border-slate-800 shadow-2xl lg:w-[24rem]" src={cover} alt="Front cover of the book Data Management Interactions with Computer Architecture and Systems"/>
		</div>
		<section class="text-slate-200">
			<div class="rounded-3xl border border-slate-800 bg-slate-900/70 p-8 shadow-xl">
				<h1 class="text-4xl text-amber-300 lg:text-6xl">Errata</h1>
				<p class="mt-4 text-lg text-slate-300">
					Please report errors to
					<a class="font-semibold text-sky-300 hover:underline" href="mailto:lee.rubao@ieee.org">lee.rubao@ieee.org</a>.
				</p>
				<div class="mt-8">
					<Error
						page="N/A"
						line="N/A"
						original="No errata posted yet"
						change="Updates will appear here as corrections are collected"
						reporter="Site editor"
						date="March 8, 2026"
					/>
				</div>
			</div>
		</section>
	</div>
</Layout>
